name: Ricardo hourly monitor

on:
schedule:
# Runs at minute 7 of every hour (UTC)
- cron: "7 * * * *"
workflow_dispatch:

permissions:
contents: write

concurrency:
group: ricardo-monitor
cancel-in-progress: false

jobs:
monitor:
runs-on: ubuntu-latest

```
steps:
  - name: Checkout
    uses: actions/checkout@v4

  - name: Set up Python
    uses: actions/setup-python@v5
    with:
      python-version: "3.12"

  - name: Install dependencies
    run: pip install -r requirements.txt

  - name: Run Ricardo monitor
    env:
      ALERT_EMAIL: ${{ secrets.ALERT_EMAIL }}
      SMTP_HOST: ${{ secrets.SMTP_HOST }}
      SMTP_PORT: ${{ secrets.SMTP_PORT }}
      SMTP_USERNAME: ${{ secrets.SMTP_USERNAME }}
      SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
      SMTP_FROM: ${{ secrets.SMTP_FROM }}

      # FIRST RUN ONLY:
      # Use "baseline" so existing listings are remembered without emailing them.
      # After the first successful run, change this to "notify".
      INITIAL_MODE: baseline

    run: python monitor.py

  - name: Save seen-listing state
    if: always()
    run: |
      if [ -f seen.json ]; then
        git config user.name "ricardo-monitor"
        git config user.email "actions@users.noreply.github.com"
        git add seen.json

        if ! git diff --cached --quiet; then
          git commit -m "Update Ricardo seen listings"
          git push
        fi
      fi
